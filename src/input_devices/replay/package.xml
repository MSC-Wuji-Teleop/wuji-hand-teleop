<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>replay</name>
  <version>0.1.0</version>
  <description>
    Replay input device for the SOT handoff bundle (RobotSTAR_demos):
    publishes a sample's G1 arm joint targets and 21-point hand keypoints as
    topics, so the existing output controllers (g1_world_output joint_replay
    mode, wujihand_controller keypoints_topic source) can drive the robot or
    the MuJoCo sim from recorded motion instead of live teleop.
  </description>
  <maintainer email="nathan.jew@berkeley.edu">Nathan Jew</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>python3-scipy</depend>
  <depend>python3-yaml</depend>
  <!-- Offline conditioning imports the limits loaders from these packages
       (g1_world_output.replay_safety, wujihand_output.hand_safety) and the
       qpos permutation from wujihand_output.wujihand_controller. All are
       import-light (numpy + yaml); no DDS or IK is pulled in. -->
  <exec_depend>g1_world_output</exec_depend>
  <exec_depend>wujihand_output</exec_depend>

  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
