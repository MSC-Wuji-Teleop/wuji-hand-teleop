<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wuji_teleop_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files for Wuji Hand and PICO 4 teleoperation presets.
  </description>
  <maintainer email="support@wuji.tech">Wuji Tech</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!-- Package dependencies -->
  <exec_depend>wujihand_output</exec_depend>
  <!-- replay.launch.py: the clip publisher and connection check, and the hand drivers it includes -->
  <exec_depend>replay</exec_depend>
  <exec_depend>starport_wuji_hand</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
